# Plantilla de variables de entorno (docs/04-arquitectura.md §9).
# Copiar a .env y ajustar. .env está ignorado en git: nunca subir secretos reales.
# Los secretos de producción se generan con `openssl rand -base64 48`.

# --- Entorno ---
NODE_ENV=development
PORT=3000
APP_TIMEZONE=America/Bogota

# --- Base de datos ---
# Debe coincidir con el servicio "db" de docker-compose.yml.
POSTGRES_USER=hato
POSTGRES_PASSWORD=hato_dev
POSTGRES_DB=hato
# Puerto en la máquina anfitriona. Cámbialo (por ejemplo 5433) si el 5432 ya
# está ocupado por otro proyecto; actualiza también DATABASE_URL.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://hato:hato_dev@localhost:5432/hato?schema=public

# --- Autenticación (valores de ejemplo, reemplazar en cada entorno) ---
JWT_ACCESS_SECRET=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
REFRESH_TOKEN_PEPPER=cambiar-por-un-pepper-aleatorio-de-al-menos-32-caracteres

# --- Clientes ---
# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173
# URL pública de la web, usada en los códigos QR de los animales.
PUBLIC_WEB_URL=http://localhost:5173

# --- Desarrollo y pruebas ---
# Fecha fija de "hoy" para el seed y las pruebas deterministas (08 §3).
SEED_TODAY=2026-09-25

# --- Almacenamiento S3 para respaldos y fotos (M10) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=hato-backups
S3_ACCESS_KEY_ID=cambiar
S3_SECRET_ACCESS_KEY=cambiar

{
  "name": "@hato/api",
  "version": "0.0.0",
  "private": true,
  "description": "API REST de Arreo (NestJS + Fastify + Prisma)",
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:tz": "node scripts/test-timezones.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:nueva:test": "node --conditions=development --import ./prisma/seed/ts-resolve.mjs prisma/seed/reset-nueva.ts",
    "db:seed:load": "node --conditions=development --import ./prisma/seed/ts-resolve.mjs prisma/seed/seed-load.ts",
    "db:reset": "prisma migrate reset --force && prisma db seed"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/multipart": "10.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@hato/shared": "workspace:*",
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-fastify": "12.1.0",
    "@node-rs/argon2": "2.0.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "exceljs": "4.4.0",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@hato/config": "workspace:*",
    "@nestjs/cli": "12.0.7",
    "@nestjs/schematics": "12.0.5",
    "@nestjs/testing": "12.1.0",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.2",
    "@types/node": "24.9.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "dotenv": "18.0.3",
    "pino-pretty": "13.1.3",
    "prisma": "7.10.0",
    "supertest": "7.3.0",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  }
}

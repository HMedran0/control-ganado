// Esquema de la API. Copiado de docs/referencia/schema.prisma en M0.3a; ese archivo es la
// especificación de partida y no se edita. Todo cambio posterior se hace aquí, con migración.
// Índices parciales, pg_trgm y CHECKs se agregan en una migración SQL manual (ver 03-modelo-datos.md §5).
// IDs: UUIDv7 generados en la aplicación (packages/shared/src/id.ts), por eso no hay @default en id.
// Prisma 7: la URL de conexión va en apps/api/prisma.config.ts y el cliente usa el adaptador
// @prisma/adapter-pg.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // apps/api es ESM porque NestJS 12 se publica solo como módulos ES. La documentación de
  // Prisma 7 advierte que el generador infiere el formato del entorno, así que se fija a mano.
  // Ver docs/adr/005-api-esm.md.
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OPERATOR
  VET
}

enum BreedGroup {
  INDICUS
  TAURUS
  CROSS
}

enum VaccineScheduleType {
  OFFICIAL_CYCLE
  AGE_WINDOW
  INTERVAL
  NONE
}

enum Sex {
  FEMALE
  MALE
}

enum Origin {
  BORN_ON_FARM
  PURCHASED
}

enum ExitType {
  SALE
  DEATH
  SLAUGHTER
  THEFT
  TRANSFER
  OTHER
}

enum IdentifierType {
  VISUAL_TAG
  DIN
  RFID
  QR
  BRAND
  OTHER
}

enum IdentifierRetireReason {
  LOST
  DAMAGED
  REASSIGNED
  OTHER
  EXITED
  ARCHIVED
}

/// Dónde va el chip RFID (ajuste previo de M9). Solo con type = RFID (CHECK en la migración).
enum RfidCarrier {
  EAR_TAG
  INJECTABLE
  BOLUS
}

enum ServiceMethod {
  NATURAL
  AI
  UNKNOWN
}

enum PregnancyOutcome {
  PENDING
  CALVED
  ABORTED
  FAILED
}

enum CalvingType {
  NORMAL
  ASSISTED
  CESAREAN
}

/// Estado al nacer de una cría viva registrada con su parto (REP-04, NAC-01 CA2).
enum BirthCondition {
  HEALTHY
  WEAK
}

enum WeightMethod {
  SCALE
  TAPE
  ESTIMATE
}

/// Cómo se identificó al animal al registrar el evento (PES-01, PIL-05; M6).
enum IdentifiedBy {
  RFID_READER
  QR
  SEARCH
  IMPORT
}

/// De dónde salió el peso (PES-01, PIL-05; M6).
enum WeightSource {
  MANUAL
  SCALE_FILE
  SCALE_LIVE
}

/// Formato del archivo de la báscula (PES-04).
enum ScaleFileFormat {
  CSV
  XLSX
}

/// Qué importó un lote de importación (ANI-09 o PES-04).
enum ImportKind {
  ANIMALS
  WEIGHTS
}

enum ExpenseType {
  PURCHASE
  FEED
  MEDICATION
  VACCINE
  VETERINARY
  TRANSPORT
  OTHER
}

enum AllocationMethod {
  DIRECT
  EQUAL
  BY_WEIGHT
  /// Gasto general de la finca (M7): no se asigna a animales ni entra en su inversión.
  GENERAL
}

enum ValuationMethod {
  MANUAL
  PRICE_PER_KG
}

enum WorkSessionStatus {
  OPEN
  CLOSED
}

enum AuditAction {
  CREATE
  UPDATE
  ARCHIVE
  RESTORE
  VOID
  EXIT
  REVERT_EXIT
  LOGIN
  IMPORT
  REVOKE_SESSIONS
  EXPORT
}

model Farm {
  id             String   @id @db.Uuid
  name           String
  municipality   String?
  department     String?
  icaPremiseCode String?  @map("ica_premise_code")
  settings       Json
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz

  memberships     Membership[]
  animals         Animal[]
  breeds          Breed[]
  vaccines        Vaccine[]
  lots            Lot[]
  tags            Tag[]
  expenses        Expense[]
  workSessions    WorkSession[]
  cycles          VaccinationCycle[]
  importBatches   ImportBatch[]
  animalTags      AnimalTag[]
  idempotencyKeys IdempotencyKey[]
  cycleVaccines   VaccinationCycleVaccine[]
  scaleProfiles   ScaleProfile[]

  @@map("farms")
}

model User {
  id                 String    @id @db.Uuid
  name               String
  username           String    @unique
  email              String?   @unique
  passwordHash       String    @map("password_hash")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  isActive           Boolean   @default(true) @map("is_active")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  memberships   Membership[]
  refreshTokens RefreshToken[]
  diagnoses     Pregnancy[]

  @@map("users")
}

model Membership {
  id       String  @id @db.Uuid
  userId   String  @map("user_id") @db.Uuid
  farmId   String  @map("farm_id") @db.Uuid
  role     Role
  isActive Boolean @default(true) @map("is_active")

  user User @relation(fields: [userId], references: [id])
  farm Farm @relation(fields: [farmId], references: [id])

  @@unique([userId, farmId])
  @@map("memberships")
}

model RefreshToken {
  id              String    @id @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  // Finca activa de la sesión: la rotación la conserva, así que renovar el token no
  // devuelve al usuario a su finca por defecto (M1; ver docs/adr/007-autenticacion.md).
  farmId          String    @map("farm_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash")
  familyId        String    @map("family_id") @db.Uuid
  /// Inicio de sesión (con contraseña o, desde M10a, con Google) que originó la familia. Se
  /// copia de token en token y fija el tope absoluto de la sesión (AUT-10 CA2, ADR-007 dec. 6).
  familyStartedAt DateTime  @map("family_started_at") @db.Timestamptz
  /// Último uso de la sesión (AUT-11). Se renueva al rotar, como máximo una vez por hora.
  lastUsedAt      DateTime  @map("last_used_at") @db.Timestamptz
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz
  userAgent       String?   @map("user_agent")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

model Breed {
  id            String     @id @db.Uuid
  farmId        String     @map("farm_id") @db.Uuid
  name          String
  group         BreedGroup @default(CROSS)
  gestationDays Int?       @map("gestation_days")
  isActive      Boolean    @default(true) @map("is_active")
  version       Int        @default(1)
  updatedAt     DateTime   @default(now()) @map("updated_at") @db.Timestamptz

  farm    Farm     @relation(fields: [farmId], references: [id])
  animals Animal[]

  @@unique([farmId, name])
  @@index([farmId, updatedAt])
  @@map("breeds")
}

model Vaccine {
  id                  String              @id @db.Uuid
  farmId              String              @map("farm_id") @db.Uuid
  name                String
  disease             String
  defaultDose         String?             @map("default_dose")
  route               String?
  scheduleType        VaccineScheduleType @default(INTERVAL) @map("schedule_type")
  boosterIntervalDays Int?                @map("booster_interval_days")
  eligibleSex         Sex?                @map("eligible_sex")
  minAgeDays          Int?                @map("min_age_days")
  maxAgeDays          Int?                @map("max_age_days")
  blockIneligibleSex  Boolean             @default(false) @map("block_ineligible_sex")
  isActive            Boolean             @default(true) @map("is_active")
  version             Int                 @default(1)
  updatedAt           DateTime            @default(now()) @map("updated_at") @db.Timestamptz

  farm    Farm                      @relation(fields: [farmId], references: [id])
  records VaccinationRecord[]
  cycles  VaccinationCycleVaccine[]

  @@unique([farmId, name])
  @@index([farmId, updatedAt])
  @@map("vaccines")
}

model Lot {
  id          String   @id @db.Uuid
  farmId      String   @map("farm_id") @db.Uuid
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  version     Int      @default(1)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz

  farm     Farm      @relation(fields: [farmId], references: [id])
  animals  Animal[]
  expenses Expense[]

  @@unique([farmId, name])
  @@index([farmId, updatedAt])
  @@map("lots")
}

model Tag {
  id          String   @id @db.Uuid
  farmId      String   @map("farm_id") @db.Uuid
  // Se genera del nombre al crear la etiqueta y no cambia aunque se renombre (M3).
  key         String
  label       String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  isActive    Boolean  @default(true) @map("is_active")
  version     Int      @default(1)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz

  farm    Farm        @relation(fields: [farmId], references: [id])
  animals AnimalTag[]

  @@unique([farmId, key])
  @@index([farmId, updatedAt])
  @@map("tags")
}

model Animal {
  id                    String          @id @db.Uuid
  farmId                String          @map("farm_id") @db.Uuid
  code                  String
  name                  String?
  sex                   Sex
  breedId               String          @map("breed_id") @db.Uuid
  birthDate             DateTime        @map("birth_date") @db.Date
  birthDateEstimated    Boolean         @default(false) @map("birth_date_estimated")
  origin                Origin
  originDetail          String?         @map("origin_detail")
  entryDate             DateTime        @map("entry_date") @db.Date
  /// La fecha de ingreso no se conocía y se tomó la de nacimiento (importación, ANI-09). Deja
  /// de ser estimada cuando alguien la corrige en la ficha.
  entryDateEstimated    Boolean         @default(false) @map("entry_date_estimated")
  /// Partos anteriores al sistema que llegaron por importación sin fecha (ANI-09 CA6, RN-29).
  /// Número de partos = este valor + preñeces `CALVED` registradas. Nunca crea crías ni fechas.
  importedPriorCalvings Int             @default(0) @map("imported_prior_calvings")
  damId                 String?         @map("dam_id") @db.Uuid
  sireId                String?         @map("sire_id") @db.Uuid
  sireExternalRef       String?         @map("sire_external_ref")
  birthPregnancyId      String?         @map("birth_pregnancy_id") @db.Uuid
  /// Estado al nacer, solo en las crías registradas con su parto (REP-04, NAC-01 CA2).
  birthCondition        BirthCondition? @map("birth_condition")
  lotId                 String?         @map("lot_id") @db.Uuid
  forSale               Boolean         @default(false) @map("for_sale")
  exitType              ExitType?       @map("exit_type")
  exitDate              DateTime?       @map("exit_date") @db.Date
  exitReason            String?         @map("exit_reason")
  photoUrl              String?         @map("photo_url")
  notes                 String?
  version               Int             @default(1)
  createdById           String          @map("created_by_id") @db.Uuid
  updatedById           String          @map("updated_by_id") @db.Uuid
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime        @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt             DateTime?       @map("deleted_at") @db.Timestamptz
  deletedReason         String?         @map("deleted_reason")

  farm            Farm       @relation(fields: [farmId], references: [id])
  breed           Breed      @relation(fields: [breedId], references: [id])
  lot             Lot?       @relation(fields: [lotId], references: [id])
  dam             Animal?    @relation("DamOffspring", fields: [damId], references: [id])
  offspringAsDam  Animal[]   @relation("DamOffspring")
  sire            Animal?    @relation("SireOffspring", fields: [sireId], references: [id])
  offspringAsSire Animal[]   @relation("SireOffspring")
  birthPregnancy  Pregnancy? @relation("PregnancyCalves", fields: [birthPregnancyId], references: [id])

  pregnancies        Pregnancy[]         @relation("DamPregnancies")
  pregnanciesAsSire  Pregnancy[]         @relation("SirePregnancies")
  identifiers        Identifier[]
  tags               AnimalTag[]
  vaccinations       VaccinationRecord[]
  treatments         TreatmentRecord[]
  weights            WeightRecord[]
  lotMovements       LotMovement[]
  allocations        ExpenseAllocation[]
  sales              Sale[]
  valuations         Valuation[]
  workSessionEntries WorkSessionEntry[]

  // Desde M4c (RN-30, RN-31), en migración SQL manual: único parcial sobre
  // (farm_id, hato_normalize_code(code)) de los activos y un índice no único sobre la misma
  // expresión. Prisma no expresa índices sobre funciones, así que no se declaran aquí.
  @@index([farmId])
  @@index([farmId, lotId])
  @@index([damId])
  @@index([sireId])
  @@index([farmId, birthDate])
  // Los índices GIN de pg_trgm los creó la migración manual, pero se declaran aquí con su
  // nombre para que `prisma migrate dev` no los tome por sobrantes y los elimine.
  @@index([code(ops: raw("gin_trgm_ops"))], map: "animals_code_trgm_idx", type: Gin)
  @@index([name(ops: raw("gin_trgm_ops"))], map: "animals_name_trgm_idx", type: Gin)
  @@index([farmId, updatedAt])
  @@map("animals")
}

/// Etiqueta manual de un animal (CLS-02). Quitar una etiqueta no borra la fila: se marca
/// `removed_at` (ADR-012), para que la sincronización lleve el cambio. Una etiqueta vigente es
/// única por animal: índice único parcial (animal_id, tag_id) WHERE removed_at IS NULL, en la
/// migración SQL.
model AnimalTag {
  id          String    @id @db.Uuid
  farmId      String    @map("farm_id") @db.Uuid
  animalId    String    @map("animal_id") @db.Uuid
  tagId       String    @map("tag_id") @db.Uuid
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  removedAt   DateTime? @map("removed_at") @db.Timestamptz
  removedById String?   @map("removed_by_id") @db.Uuid
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  farm   Farm   @relation(fields: [farmId], references: [id])
  animal Animal @relation(fields: [animalId], references: [id])
  tag    Tag    @relation(fields: [tagId], references: [id])

  @@index([animalId])
  @@index([tagId])
  @@index([farmId, updatedAt])
  @@map("animal_tags")
}

model Identifier {
  id           String                  @id @db.Uuid
  farmId       String                  @map("farm_id") @db.Uuid
  animalId     String                  @map("animal_id") @db.Uuid
  type         IdentifierType
  value        String
  assignedAt   DateTime                @map("assigned_at") @db.Date
  retiredAt    DateTime?               @map("retired_at") @db.Date
  retireReason IdentifierRetireReason? @map("retire_reason")
  replacedById String?                 @map("replaced_by_id") @db.Uuid
  carrier      RfidCarrier?
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime                @default(now()) @map("updated_at") @db.Timestamptz

  animal     Animal       @relation(fields: [animalId], references: [id])
  replacedBy Identifier?  @relation("IdentifierReplacement", fields: [replacedById], references: [id])
  replaces   Identifier[] @relation("IdentifierReplacement")

  // Único parcial (farm_id, type, value) WHERE retired_at IS NULL → migración SQL manual.
  @@index([farmId, value])
  @@index([animalId])
  @@index([value(ops: raw("gin_trgm_ops"))], map: "identifiers_value_trgm_idx", type: Gin)
  @@index([farmId, updatedAt])
  @@map("identifiers")
}

model Pregnancy {
  id                         String           @id @db.Uuid
  farmId                     String           @map("farm_id") @db.Uuid
  damId                      String           @map("dam_id") @db.Uuid
  serviceDate                DateTime         @map("service_date") @db.Date
  serviceDateEstimated       Boolean          @default(false) @map("service_date_estimated")
  method                     ServiceMethod
  sireId                     String?          @map("sire_id") @db.Uuid
  sireExternalRef            String?          @map("sire_external_ref")
  confirmedAt                DateTime?        @map("confirmed_at") @db.Date
  /// Quién palpó (REP-02 CA1): texto, porque suele ser un veterinario externo que no es usuario.
  diagnosisResponsible       String?          @map("diagnosis_responsible")
  /// Si quien palpó es usuario de la finca.
  diagnosisResponsibleUserId String?          @map("diagnosis_responsible_user_id") @db.Uuid
  /// Observaciones de la palpación (M6): aparte de las de la preñez para no pisarlas.
  diagnosisNotes             String?          @map("diagnosis_notes")
  expectedCalvingDate        DateTime         @map("expected_calving_date") @db.Date
  /// El parto estimado se corrigió a mano (PATCH): el recálculo por gestación no lo toca (M5).
  expectedCalvingManual      Boolean          @default(false) @map("expected_calving_manual")
  outcome                    PregnancyOutcome @default(PENDING)
  outcomeDate                DateTime?        @map("outcome_date") @db.Date
  calvingType                CalvingType?     @map("calving_type")
  stillbornCount             Int              @default(0) @map("stillborn_count")
  isImported                 Boolean          @default(false) @map("is_imported")
  responsible                String?
  notes                      String?
  version                    Int              @default(1)
  createdById                String           @map("created_by_id") @db.Uuid
  updatedById                String           @map("updated_by_id") @db.Uuid
  createdAt                  DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime         @default(now()) @map("updated_at") @db.Timestamptz
  voidedAt                   DateTime?        @map("voided_at") @db.Timestamptz
  voidReason                 String?          @map("void_reason")

  dam                      Animal   @relation("DamPregnancies", fields: [damId], references: [id])
  diagnosisResponsibleUser User?    @relation(fields: [diagnosisResponsibleUserId], references: [id])
  sire                     Animal?  @relation("SirePregnancies", fields: [sireId], references: [id])
  calves                   Animal[] @relation("PregnancyCalves")

  // Único parcial (dam_id) WHERE outcome='PENDING' AND voided_at IS NULL → migración SQL manual.
  @@index([farmId, outcome, expectedCalvingDate])
  @@index([damId])
  @@index([farmId, updatedAt])
  @@map("pregnancies")
}

model VaccinationRecord {
  id            String    @id @db.Uuid
  farmId        String    @map("farm_id") @db.Uuid
  animalId      String    @map("animal_id") @db.Uuid
  vaccineId     String    @map("vaccine_id") @db.Uuid
  appliedOn     DateTime  @map("applied_on") @db.Date
  dose          String?
  batchNumber   String?   @map("batch_number")
  ruvNumber     String?   @map("ruv_number")
  cycleId       String?   @map("cycle_id") @db.Uuid
  responsible   String?
  nextDueOn     DateTime? @map("next_due_on") @db.Date
  workSessionId String?   @map("work_session_id") @db.Uuid
  notes         String?
  createdById   String    @map("created_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  voidedAt      DateTime? @map("voided_at") @db.Timestamptz
  voidReason    String?   @map("void_reason")

  animal      Animal            @relation(fields: [animalId], references: [id])
  vaccine     Vaccine           @relation(fields: [vaccineId], references: [id])
  cycle       VaccinationCycle? @relation(fields: [cycleId], references: [id])
  workSession WorkSession?      @relation(fields: [workSessionId], references: [id])

  @@index([farmId, animalId, vaccineId, appliedOn(sort: Desc)])
  @@index([farmId, nextDueOn])
  @@index([farmId, updatedAt])
  @@map("vaccination_records")
}

model TreatmentRecord {
  id                 String    @id @db.Uuid
  farmId             String    @map("farm_id") @db.Uuid
  animalId           String    @map("animal_id") @db.Uuid
  startedOn          DateTime  @map("started_on") @db.Date
  reason             String
  medication         String
  dose               String?
  durationDays       Int       @default(1) @map("duration_days")
  withdrawalMeatDays Int       @default(0) @map("withdrawal_meat_days")
  withdrawalMilkDays Int       @default(0) @map("withdrawal_milk_days")
  withdrawalUntil    DateTime? @map("withdrawal_until") @db.Date
  responsible        String?
  workSessionId      String?   @map("work_session_id") @db.Uuid
  /// Gasto del costo del tratamiento (SAN-05, solo ADMIN, RN-20). M6.
  expenseId          String?   @map("expense_id") @db.Uuid
  notes              String?
  createdById        String    @map("created_by_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  voidedAt           DateTime? @map("voided_at") @db.Timestamptz
  voidReason         String?   @map("void_reason")

  animal      Animal       @relation(fields: [animalId], references: [id])
  workSession WorkSession? @relation(fields: [workSessionId], references: [id])
  expense     Expense?     @relation(fields: [expenseId], references: [id])

  @@index([farmId, animalId])
  @@index([farmId, withdrawalUntil])
  @@index([farmId, updatedAt])
  @@map("treatment_records")
}

model WeightRecord {
  id            String        @id @db.Uuid
  farmId        String        @map("farm_id") @db.Uuid
  animalId      String        @map("animal_id") @db.Uuid
  weighedOn     DateTime      @map("weighed_on") @db.Date
  weightKg      Decimal       @map("weight_kg") @db.Decimal(7, 2)
  method        WeightMethod  @default(SCALE)
  isBirthWeight Boolean       @default(false) @map("is_birth_weight")
  /// Nulo cuando nadie identificó al animal: seed, peso al nacer, peso inicial (M6).
  identifiedBy  IdentifiedBy? @map("identified_by")
  weightSource  WeightSource  @default(MANUAL) @map("weight_source")
  /// Número de serie del indicador en el pesaje en vivo (PES-03 CA6, M15).
  scaleSerial   String?       @map("scale_serial")
  workSessionId String?       @map("work_session_id") @db.Uuid
  notes         String?
  createdById   String        @map("created_by_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @default(now()) @map("updated_at") @db.Timestamptz
  voidedAt      DateTime?     @map("voided_at") @db.Timestamptz
  voidReason    String?       @map("void_reason")

  animal      Animal       @relation(fields: [animalId], references: [id])
  workSession WorkSession? @relation(fields: [workSessionId], references: [id])

  @@index([animalId, weighedOn(sort: Desc)])
  @@index([farmId, updatedAt])
  @@map("weight_records")
}

model LotMovement {
  id            String   @id @db.Uuid
  farmId        String   @map("farm_id") @db.Uuid
  animalId      String   @map("animal_id") @db.Uuid
  fromLotId     String?  @map("from_lot_id") @db.Uuid
  toLotId       String?  @map("to_lot_id") @db.Uuid
  movedOn       DateTime @map("moved_on") @db.Date
  workSessionId String?  @map("work_session_id") @db.Uuid
  createdById   String   @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz

  animal Animal @relation(fields: [animalId], references: [id])

  @@index([animalId])
  @@index([farmId, updatedAt])
  @@map("lot_movements")
}

model Expense {
  id               String           @id @db.Uuid
  farmId           String           @map("farm_id") @db.Uuid
  type             ExpenseType
  occurredOn       DateTime         @map("occurred_on") @db.Date
  amount           Decimal          @db.Decimal(14, 2)
  description      String
  allocationMethod AllocationMethod @map("allocation_method")
  /// Lote elegido al repartir (M7). Las asignaciones se fijan al guardar: los animales que
  /// entren o salgan del lote después no cambian el reparto.
  lotId            String?          @map("lot_id") @db.Uuid
  version          Int              @default(1)
  createdById      String           @map("created_by_id") @db.Uuid
  updatedById      String           @map("updated_by_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @default(now()) @map("updated_at") @db.Timestamptz
  voidedAt         DateTime?        @map("voided_at") @db.Timestamptz
  voidReason       String?          @map("void_reason")

  farm        Farm                @relation(fields: [farmId], references: [id])
  lot         Lot?                @relation(fields: [lotId], references: [id])
  allocations ExpenseAllocation[]
  treatments  TreatmentRecord[]

  @@index([farmId, occurredOn])
  @@index([farmId, updatedAt])
  @@map("expenses")
}

model ExpenseAllocation {
  id        String    @id @db.Uuid
  farmId    String    @map("farm_id") @db.Uuid
  expenseId String    @map("expense_id") @db.Uuid
  animalId  String    @map("animal_id") @db.Uuid
  amount    Decimal   @db.Decimal(14, 2)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  /// Anulada al anular el gasto o al corregirlo (M7, RN-11): la corrección crea las nuevas.
  voidedAt  DateTime? @map("voided_at") @db.Timestamptz

  expense Expense @relation(fields: [expenseId], references: [id])
  animal  Animal  @relation(fields: [animalId], references: [id])

  @@index([animalId])
  @@index([expenseId])
  @@index([farmId, updatedAt])
  @@map("expense_allocations")
}

model Sale {
  id          String    @id @db.Uuid
  farmId      String    @map("farm_id") @db.Uuid
  animalId    String    @map("animal_id") @db.Uuid
  soldOn      DateTime  @map("sold_on") @db.Date
  amount      Decimal   @db.Decimal(14, 2)
  buyer       String?
  notes       String?
  version     Int       @default(1)
  createdById String    @map("created_by_id") @db.Uuid
  updatedById String    @map("updated_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  voidedAt    DateTime? @map("voided_at") @db.Timestamptz
  voidReason  String?   @map("void_reason")

  animal Animal @relation(fields: [animalId], references: [id])

  // Único parcial (animal_id) WHERE voided_at IS NULL → migración SQL manual.
  @@index([farmId, soldOn])
  @@index([farmId, updatedAt])
  @@map("sales")
}

model Valuation {
  id          String          @id @db.Uuid
  farmId      String          @map("farm_id") @db.Uuid
  animalId    String          @map("animal_id") @db.Uuid
  valuedOn    DateTime        @map("valued_on") @db.Date
  amount      Decimal         @db.Decimal(14, 2)
  method      ValuationMethod
  createdById String          @map("created_by_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime        @default(now()) @map("updated_at") @db.Timestamptz
  /// Un avalúo no se edita: se anula y se registra otro (M7).
  voidedAt    DateTime?       @map("voided_at") @db.Timestamptz
  voidReason  String?         @map("void_reason")

  animal Animal @relation(fields: [animalId], references: [id])

  @@index([animalId, valuedOn(sort: Desc)])
  @@index([farmId, updatedAt])
  @@map("valuations")
}

model WorkSession {
  id            String            @id @db.Uuid
  farmId        String            @map("farm_id") @db.Uuid
  name          String
  sessionDate   DateTime          @map("session_date") @db.Date
  activities    Json
  expectedLotId String?           @map("expected_lot_id") @db.Uuid
  status        WorkSessionStatus @default(OPEN)
  closedAt      DateTime?         @map("closed_at") @db.Timestamptz
  createdById   String            @map("created_by_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime          @default(now()) @map("updated_at") @db.Timestamptz

  farm         Farm                @relation(fields: [farmId], references: [id])
  entries      WorkSessionEntry[]
  vaccinations VaccinationRecord[]
  treatments   TreatmentRecord[]
  weights      WeightRecord[]
  imports      ImportBatch[]

  @@index([farmId, sessionDate])
  @@index([farmId, updatedAt])
  @@map("work_sessions")
}

model WorkSessionEntry {
  id            String   @id @db.Uuid
  workSessionId String   @map("work_session_id") @db.Uuid
  animalId      String   @map("animal_id") @db.Uuid
  processedAt   DateTime @default(now()) @map("processed_at") @db.Timestamptz
  createdById   String   @map("created_by_id") @db.Uuid

  workSession WorkSession @relation(fields: [workSessionId], references: [id])
  animal      Animal      @relation(fields: [animalId], references: [id])

  @@unique([workSessionId, animalId])
  @@map("work_session_entries")
}

model AuditLog {
  id        BigInt      @id @default(autoincrement())
  farmId    String      @map("farm_id") @db.Uuid
  userId    String?     @map("user_id") @db.Uuid
  entity    String
  entityId  String      @map("entity_id") @db.Uuid
  action    AuditAction
  diff      Json?
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz

  @@index([farmId, entity, entityId])
  @@index([farmId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model VaccinationCycle {
  id         String   @id @db.Uuid
  farmId     String   @map("farm_id") @db.Uuid
  name       String
  startsOn   DateTime @map("starts_on") @db.Date
  endsOn     DateTime @map("ends_on") @db.Date
  isOfficial Boolean  @default(true) @map("is_official")
  isActive   Boolean  @default(true) @map("is_active")
  version    Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz

  farm         Farm                      @relation(fields: [farmId], references: [id])
  vaccines     VaccinationCycleVaccine[]
  vaccinations VaccinationRecord[]

  @@unique([farmId, name])
  @@index([farmId, startsOn])
  @@index([farmId, updatedAt])
  @@map("vaccination_cycles")
}

/// Vacunas de un ciclo (SAN-06). Desde M6 (ADR-012) quitar una vacuna del ciclo no borra la fila:
/// marca `removed_at` y `removed_by_id`. Única vigente por (ciclo, vacuna): índice único parcial
/// `vaccination_cycle_vaccines_active_uq` WHERE removed_at IS NULL, en la migración SQL.
model VaccinationCycleVaccine {
  id          String    @id @db.Uuid
  farmId      String    @map("farm_id") @db.Uuid
  cycleId     String    @map("cycle_id") @db.Uuid
  vaccineId   String    @map("vaccine_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  removedAt   DateTime? @map("removed_at") @db.Timestamptz
  removedById String?   @map("removed_by_id") @db.Uuid
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  farm    Farm             @relation(fields: [farmId], references: [id])
  cycle   VaccinationCycle @relation(fields: [cycleId], references: [id])
  vaccine Vaccine          @relation(fields: [vaccineId], references: [id])

  @@index([cycleId])
  @@index([vaccineId])
  @@index([farmId, updatedAt])
  @@map("vaccination_cycle_vaccines")
}

/// Respuesta guardada de una acción con encabezado `Idempotency-Key` (ADR-012 §2): la misma
/// clave con la misma petición devuelve esta respuesta sin repetir la acción. Se purga a los 7
/// días. Nunca guarda respuestas de `/auth`. La importación no la usa: su clave vive en
/// `import_batches.idempotency_key` (ADR-011).
model IdempotencyKey {
  id             String   @id @db.Uuid
  farmId         String   @map("farm_id") @db.Uuid
  key            String   @db.Uuid
  method         String
  path           String
  /// SHA-256 del método, la ruta y el cuerpo canónico de la petición.
  requestHash    String   @map("request_hash")
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  farm Farm @relation(fields: [farmId], references: [id])

  @@unique([farmId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

model ImportBatch {
  id             String     @id @db.Uuid
  farmId         String     @map("farm_id") @db.Uuid
  /// Clave que la web genera al elegir el archivo: un doble clic o un reintento con la misma
  /// clave devuelve el lote ya creado en lugar de importar otra vez (ADR-011).
  idempotencyKey String     @map("idempotency_key") @db.Uuid
  /// SHA-256 del archivo: la simulación avisa si ese mismo archivo ya se importó.
  fileSha256     String     @map("file_sha256")
  /// Inventario (ANI-09) o sesión de la báscula (PES-04, M6).
  kind           ImportKind @default(ANIMALS)
  /// Jornada de pesaje que creó la importación de la báscula (PES-04 CA4).
  workSessionId  String?    @map("work_session_id") @db.Uuid
  fileName       String     @map("file_name")
  totalRows      Int        @map("total_rows")
  createdRows    Int        @map("created_rows")
  errorRows      Int        @map("error_rows")
  summary        Json
  createdById    String     @map("created_by_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz

  farm        Farm         @relation(fields: [farmId], references: [id])
  workSession WorkSession? @relation(fields: [workSessionId], references: [id])

  @@unique([farmId, idempotencyKey])
  @@index([farmId, fileSha256])
  @@index([workSessionId])
  @@index([farmId, createdAt])
  @@map("import_batches")
}

/// Intentos de inicio de sesión, para el bloqueo por intentos fallidos (AUT-01 CA3).
///
/// No tiene `farm_id`: el intento ocurre antes de saber a qué finca pertenece quien
/// escribe, e incluso antes de saber si el usuario existe. El bloqueo no se almacena, se
/// deduce de estas filas (docs/adr/007-autenticacion.md).
///
/// Guarda una dirección IP, que es un dato personal: las filas de más de 30 días se borran
/// (`LoginAttemptsService.purgeOld`).
model LoginAttempt {
  id        BigInt   @id @default(autoincrement())
  /// Tal como lo escribió quien intenta entrar, en minúsculas. Puede no existir.
  login     String
  ip        String
  succeeded Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([login, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
  @@map("login_attempts")
}

/// Perfil de báscula de la finca (PES-04, M6): cómo leer el archivo que exporta su indicador. Las
/// plantillas del sistema (Tru-Test) no son filas: viven en packages/shared. Único por finca sin
/// distinguir mayúsculas (índice sobre lower(name) en la migración SQL), como los catálogos.
model ScaleProfile {
  id                    String          @id @db.Uuid
  farmId                String          @map("farm_id") @db.Uuid
  name                  String
  fileFormat            ScaleFileFormat @map("file_format")
  columnMapping         Json            @map("column_mapping")
  /// Plantilla del sistema de la que se duplicó, y su versión en ese momento.
  sourceTemplateKey     String?         @map("source_template_key")
  sourceTemplateVersion Int?            @map("source_template_version")
  version               Int             @default(1)
  createdById           String          @map("created_by_id") @db.Uuid
  updatedById           String          @map("updated_by_id") @db.Uuid
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime        @default(now()) @map("updated_at") @db.Timestamptz

  farm Farm @relation(fields: [farmId], references: [id])

  @@index([farmId, updatedAt])
  @@map("scale_profiles")
}

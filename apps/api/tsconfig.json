{
  // Sin `erasableSyntaxOnly`: NestJS (M0.2) usa parameter properties en los constructores
  // para la inyección de dependencias, y esa sintaxis no es borrable.
  "extends": "@hato/config/tsconfig/base.json",
  "compilerOptions": {
    "types": ["node"],
    // Resuelve @hato/shared a su código fuente (ADR-003): el typecheck no necesita
    // compilar shared antes. En tiempo de ejecución Node usa dist/ (condición "default").
    "customConditions": ["development"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts"]
}

{
  "extends": "@hato/config/tsconfig/base.json",
  "compilerOptions": {
    // DOM porque las funciones de `page.evaluate` de Playwright se ejecutan en el navegador.
    "lib": ["es2023", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "customConditions": ["development"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "erasableSyntaxOnly": true
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "e2e-database.d.mts",
    "e2e/**/*.ts"
  ]
}
